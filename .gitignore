# El folder .vscode guarda la configuración de lanzamiento y tareas de
# VS Code, que podrías querer compartir en el repo, así que esta línea
# queda comentada por defecto.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio deja los artefactos de build acá
/android/app/debug
/android/app/profile
/android/app/release

# Resultados de `flutter test --coverage`
coverage/

# Servidor de autenticacion (Dart): datos locales de SQLite y variables de
# entorno con secretos. pubspec.lock SI se versiona (es un paquete de
# aplicacion, no una libreria reutilizable).
/server/data/
/server/.env
/server/*.sqlite
/server/*.sqlite-journal
/server/*.sqlite-wal
/server/*.sqlite-shm
