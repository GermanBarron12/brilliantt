# Copiar a .env (nunca versionar .env) y ajustar segun el entorno.

# Puerto HTTP del servidor.
PORT=3000

# Ruta del archivo SQLite. En produccion, usar una ruta fuera del repositorio.
DATABASE_PATH=./data/brilliant-auth.sqlite

# Duracion de una sesion nueva, en dias.
SESSION_TTL_DAYS=30

# Limite de intentos fallidos de login por combinacion IP+usuario en la ventana (ms).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Limite de solicitudes de registro por IP en la ventana (ms).
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5

# "production" exige HTTPS terminado por un proxy inverso delante del proceso Node.
NODE_ENV=development

# Origenes permitidos para CORS, separados por coma (por ejemplo,
# http://localhost:8765 para la app web en desarrollo). Para jugar en red
# local hacen falta dos: el de quien hospeda (localhost) y el de los demas
# (la IP de esa maquina). Los clientes nativos (Android/iOS) no necesitan
# esto. Dejar sin definir deshabilita CORS por completo (ningun navegador
# puede llamar a la API).
# CORS_ORIGIN=http://localhost:8765,http://192.168.1.50:8765
