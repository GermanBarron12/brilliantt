# Copiar a .env (nunca versionar .env) y ajustar segun el entorno.

# Puerto HTTP del servidor.
PORT=3000

# Ruta del archivo SQLite. En produccion, usar una ruta fuera del repositorio.
DATABASE_PATH=./data/brilliant-auth.sqlite

# Duracion de una sesion nueva, en dias.
SESSION_TTL_DAYS=30

# Limite de intentos fallidos de login por combinacion IP+email en la ventana (ms).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Limite de solicitudes de registro por IP en la ventana (ms).
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5

# "production" exige HTTPS terminado por un proxy inverso delante del proceso Node.
NODE_ENV=development

# Verificacion de correo electronico (registro en dos pasos).
# Duracion del token de verificacion (enviado "por correo") y del ticket
# de corta vida que se usa para completar el registro con una contrasena.
VERIFICATION_TOKEN_TTL_MINUTES=30
VERIFICATION_TICKET_TTL_MINUTES=15

# Limite de reenvios de verificacion por correo (no por IP) en la ventana (ms).
REGISTER_RESEND_LIMIT_WINDOW_MS=3600000
REGISTER_RESEND_LIMIT_MAX_ATTEMPTS=3

# Limite de intentos de /auth/verify por IP en la ventana (ms).
VERIFY_RATE_LIMIT_WINDOW_MS=900000
VERIFY_RATE_LIMIT_MAX_ATTEMPTS=10

# Cada cuanto se limpian del todo las verificaciones vencidas, en ms.
VERIFICATION_CLEANUP_INTERVAL_MS=3600000

# Mecanismo de SOLO DESARROLLO que devuelve el token de verificacion en la
# respuesta de /auth/register, para probar el flujo sin un proveedor de
# correo real. Requiere ADEMAS que NODE_ENV no sea "production": ninguna
# de las dos condiciones por si sola lo activa. Dejar en false salvo en un
# entorno local de desarrollo.
ENABLE_DEV_VERIFICATION_TOKEN=false
