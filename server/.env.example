# Copiar a .env (nunca versionar .env) y ajustar segun el entorno.

# Puerto HTTP del servidor.
PORT=3000

# Ruta del archivo SQLite. En produccion, usar una ruta fuera del repositorio.
DATABASE_PATH=./data/brilliant-auth.sqlite

# Duracion de una sesion nueva, en dias.
SESSION_TTL_DAYS=30

# Limite de intentos fallidos de login por combinacion IP+email en la ventana (ms).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Limite de solicitudes de registro por IP en la ventana (ms).
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5

# "production" exige HTTPS terminado por un proxy inverso delante del proceso Node.
NODE_ENV=development
